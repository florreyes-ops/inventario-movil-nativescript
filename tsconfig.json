{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2017",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"]
    },
    "lib": ["es2017", "dom"]
  },
  "include": ["src/**/*.ts", "references.d.ts"],
  "exclude": ["node_modules", "platforms"]
}
